PORT=8000
DATABASE_URL=your_postgres_connection_string
# SSL is auto-enabled for non-localhost databases; set to false to override
# DATABASE_SSL=true
# Required in production, min 32 chars — generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Gemini AI (email parsing, job matching, cover letters)
GEMINI_API_KEY=your_gemini_api_key

# Gmail OAuth
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL (CORS, Socket.io, OAuth redirects)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Optional job aggregators — widen Job Finder coverage (Indeed/LinkedIn/Glassdoor etc.)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in
# RAPIDAPI_KEY=
